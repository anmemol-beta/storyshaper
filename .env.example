# Copy to .env and add your own key locally. Never put a key in browser code.
MODEL_API_KEY=
STORY_AGENT_MODEL=muse-spark-1.3
# adaptive: one call for bounded known-material turns; independent review when needed.
# Set two_call to compare against the fully reviewed path, then restart the server.
STORY_AGENT_PIPELINE=adaptive
STORY_AGENT_COMPOSE_EFFORT=low
STORY_AGENT_REVIEW_EFFORT=low
STORY_AGENT_STRUCTURED_OUTPUT=1
STORY_IMAGE_REASONING_STRENGTH=low
